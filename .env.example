# ---------------------------------------------------------------------------
# VENDO configuration example. Copy to .env.local and fill in values.
# Never commit real secrets.
# ---------------------------------------------------------------------------

# Public base URL of the site (used for canonical URLs, sitemap, emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database.
# Leave DATABASE_URL empty to use the embedded local PostgreSQL (PGlite)
# stored in PGLITE_DIR. For production use a managed PostgreSQL, e.g. Supabase:
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
PGLITE_DIR=./.data/pglite

# Image storage: "local" (./.data/uploads, dev only), "vercel-blob" (needs BLOB_READ_WRITE_TOKEN) or "supabase"
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./.data/uploads
# Required when STORAGE_DRIVER=supabase (server-side only, never exposed to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=listing-images

# Email for password recovery: "console" (prints links to server log) or "resend"
MAIL_DRIVER=console
RESEND_API_KEY=
MAIL_FROM="VENDO <no-reply@example.com>"

# Secret used to hash IPs for rate limiting / analytics (any long random string)
APP_SECRET=change-me-to-a-long-random-string

# Bearer token for GET /api/cron/maintenance (expiring listings and paid features).
# Leave empty to disable the endpoint (maintenance then runs opportunistically).
CRON_SECRET=
